DATABASE_URL=postgres://rag:rag@localhost:5432/rag
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=llama3.2

# Tuning (optional — these are the defaults)
MAX_DISTANCE=0.55   # skip LLM if best chunk cosine distance > this
TOP_K=3             # number of chunks passed to the prompt
FTS_WEIGHT=0.5      # weight of full-text score in RRF fusion
